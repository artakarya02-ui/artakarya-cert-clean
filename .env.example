# ==============================================================
# ARTAKARYA EDU CERTIFICATE SYSTEM - HOSTINGER ENVIRONMENT CONFIG
# ==============================================================

# Server Network Port
PORT=3000

# Environment Mode: 'production' | 'development'
NODE_ENV=production

# Official Production Verification Domain (Gunakan domain resmi ARTAKARYA)
# URL ini digunakan oleh QR Code dan tautan verifikasi sertifikat.
VITE_VERIFY_DOMAIN=https://sertifikat.artakarya.id
APP_URL=https://sertifikat.artakarya.id

# Session Security Secret
ADMIN_SESSION_SECRET=artakarya_secret_session_key_production_2026

# Database MySQL Hostinger (Opsional jika menggunakan MySQL eksternal / phpMyAdmin)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=artakarya_certificate_db
DB_USER=u123456789_cert_admin
DB_PASSWORD=GantiPasswordDatabaseHostingerAnda2026!
